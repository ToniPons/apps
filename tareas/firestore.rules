rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tareas
    match /rooms/{roomId} {
      allow read, create, update: if roomId.matches('^[A-Z2-9]{6}$');
      allow delete: if false;
      match /tasks/{taskId} {
        allow read, write: if roomId.matches('^[A-Z2-9]{6}$');
      }
    }

    // Gastos compartidos (pareja) — misma app hub
    match /homes/{homeId} {
      allow read, create, update: if homeId.matches('^[A-Z2-9]{6}$');
      allow delete: if false;
      match /{sub=**} {
        allow read, write: if homeId.matches('^[A-Z2-9]{6}$');
      }
    }
  }
}
