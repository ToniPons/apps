rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Listas compartidas por código de 6 caracteres.
    // Quien conoce el código puede leer/escribir esa sala.
    match /rooms/{roomId} {
      allow read, create, update: if roomId.matches('^[A-Z2-9]{6}$');
      allow delete: if false;

      match /tasks/{taskId} {
        allow read, write: if roomId.matches('^[A-Z2-9]{6}$');
      }
    }
  }
}
