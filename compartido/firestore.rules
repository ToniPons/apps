rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Gastos compartidos (pareja)
    match /homes/{homeId} {
      allow read, create, update: if homeId.matches('^[A-Z2-9]{6}$');
      allow delete: if false;
      match /{sub=**} {
        allow read, write: if homeId.matches('^[A-Z2-9]{6}$');
      }
    }
  }
}
